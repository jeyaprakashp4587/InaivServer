NODE_ENV=development
PORT=8080

# Database
MONGO_URI=mongodb://localhost:27017/rf

# JWT
JWT_ACCESS_TOKEN_SECRET=replace_with_strong_access_secret
JWT_REFRESH_TOKEN_SECRET=replace_with_strong_refresh_secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=rf-backend
JWT_AUDIENCE=rf-frontend

# OpenAI (use one of these)
OPENAI_API_KEY=
GPT_API_KEY=
GPT_MODEL=gpt-4o-mini

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=

# Redis (optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
